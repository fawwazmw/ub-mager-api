# ─── Server ──────────────────────────────────────────
SERVER_PORT=8081
SERVER_ENV=development

# ─── PostgreSQL + PostGIS + TimescaleDB ──────────────
# Using existing container: postgres_server (postgis/postgis:16-3.4 + TimescaleDB)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_NAME=ubmager
DB_SSLMODE=disable

# ─── Redis ───────────────────────────────────────────
# Using existing container: wardayagate-redis (redis:7-alpine)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ─────────────────────────────────────────────
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ─── OSRM ───────────────────────────────────────────
# Local:  http://localhost:5000 (docker compose up -d)
# Tunnel: https://osrm.wardaya.my.id
OSRM_BASE_URL=https://osrm.wardaya.my.id

# ─── ML Service ─────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
